# 四六级游戏化课堂 — 试点/生产环境变量模板（Windows）
# 用法：由 deploy/scripts/01-init-db.ps1 自动生成为 D:/cet46-pilot/server/.env，
#       里面的口令与 SECRET_KEY 都是随机生成的一次性值，不进 git。
# 手写场景照抄本模板即可，但 SECRET_KEY 与 DB_PASSWORD 必须换成随机强口令。

APP_ENV=production
# 试点服务端口：与开发验收环境的 8080 分开，同机并存
HTTP_PORT=8090

# ---- 数据库（公司/学校现成 MySQL，专用库 + 专用账号）----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cet46_pilot
DB_PASSWORD=__替换为随机强口令__
DB_NAME=cet46_pilot
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# ---- 凭证 ----
# JWT 签名密钥：生产必须随机（脚本生成 64 位），缺了服务直接拒绝启动
SECRET_KEY=__替换为 64 位随机串__

# ---- 课中实时大屏（S11 D7：部署级配置）----
LIVE_REFRESH_SECONDS=10